Private Declare Function TGOpenSerial Lib "buoy_thinkgearkit" Alias "tg_open_serial" (entryPath As String) As Integer
Private Declare Function TGOpenTCP Lib "buoy_thinkgearkit" Alias "tg_open_tcp" (host As String, port As Integer) As Integer
Private Declare Function TGOpenRFCOMM Lib "buoy_thinkgearkit" Alias "tg_open_rfcomm" (name As String) As Integer
Private Declare Function TGOpenBLE Lib "buoy_thinkgearkit" Alias "tg_open_ble" (name As String) As Integer
Private Declare Function TGReadByte Lib "buoy_thinkgearkit" Alias "tg_read_byte" (handle As Integer) As Integer
Private Declare Function TGStatus Lib "buoy_thinkgearkit" Alias "tg_status" (handle As Integer) As Integer
Private Declare Sub TGClose Lib "buoy_thinkgearkit" Alias "tg_close" (handle As Integer)
Private Declare Function TGError Lib "buoy_thinkgearkit" Alias "tg_error" () As CString
